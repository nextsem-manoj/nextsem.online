{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "production",
      "public": "out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.apk", "**/*.exe", "**/*.dmg"],
      "cleanUrls": true,
      "trailingSlash": true,
      "headers": [
        {
          "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|woff2|woff|ttf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/html/html5-canvas-2d-context-javascript-drawing",
          "destination": "/html/canvas-graphics-draw-shapes-context/",
          "type": 301
        },
        {
          "source": "/book/**",
          "destination": "/guide/",
          "type": 301
        }
      ],
      "rewrites": []
    },
    {
      "target": "staging",
      "public": "out",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.apk", "**/*.exe", "**/*.dmg"],

      "cleanUrls": true,
      "trailingSlash": true,
      "redirects": [
        {
          "source": "/html/html5-canvas-2d-context-javascript-drawing",
          "destination": "/html/canvas-graphics-draw-shapes-context/",
          "type": 301
        },
        {
          "source": "/book/**",
          "destination": "/guide/",
          "type": 301
        }
      ],
      "rewrites": []
    }
  ]
}
