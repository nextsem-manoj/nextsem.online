{
  "name": "@nextsem/academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "server": "next dev -p 3000",
    "build": "node scripts/generate-search-index.js && next build --webpack && node scripts/verify-sitemap.js",
    "start": "next start -p 3000",
    "lint": "eslint",
    "save-chat": "node scripts/save_chat.js",
    "status": "node scripts/project-status.js",
    "task": "node scripts/project-status.js",
    "mobile:bundle": "cd mobile && flutter build appbundle --target-platform android-arm,android-arm64",
    "mobile:apk": "cd mobile && flutter build apk --split-per-abi",
    "mobile:run": "cd mobile && flutter run",
    "deploy:staging": "npm run build && npx firebase-tools deploy --only hosting:staging --project bca-nextsem",
    "deploy:prod": "npm run build && npx firebase-tools deploy --only hosting:production --project bca-nextsem"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@tailwindcss/typography": "^0.5.20",
    "firebase": "^12.15.0",
    "gray-matter": "^4.0.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.22.0",
    "next": "16.2.9",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pdf2pic": "^3.2.0",
    "puppeteer-core": "^25.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
