default_platform(:android)

platform :android do
  desc "Deploy a new release to Google Play"
  lane :deploy do
    # Increment version code and name automatically
    increment_version_code
    increment_version_name
    # Build the AAB (Flutter build already done, but ensure gradle task runs)
    # gradle(task: "bundleRelease") # not needed as Flutter already builds
    supply(
      track: ENV['PLAY_STORE_TRACK'] || "internal",
      json_key: "fastlane/play_store.json",
      package_name: "online.nextsem.nextsem_mobile",
      aab: "../build/app/outputs/bundle/release/app-release.aab",
      skip_upload_metadata: false,
      skip_upload_images: false,
      skip_upload_screenshots: false
    )
  end
end
