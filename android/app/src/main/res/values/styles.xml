<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme — Dark Mode Window Background (#060c18) -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">#060c18</item>
        <item name="colorPrimaryDark">#060c18</item>
        <item name="colorAccent">#39FF14</item>
        <item name="android:windowBackground">#060c18</item>
        <item name="android:statusBarColor">#060c18</item>
        <item name="android:navigationBarColor">#060c18</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#060c18</item>
        <item name="android:statusBarColor">#060c18</item>
        <item name="android:navigationBarColor">#060c18</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#060c18</item>
        <item name="android:windowBackground">#060c18</item>
        <item name="android:statusBarColor">#060c18</item>
        <item name="android:navigationBarColor">#060c18</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>